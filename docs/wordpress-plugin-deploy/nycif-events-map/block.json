{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "nycif/events-map",
  "title": "NYCIF Events Map",
  "category": "embed",
  "icon": "location-alt",
  "description": "Embed the NYC In Focus public event map (in-article only; not for /map/).",
  "keywords": ["nyc", "map", "events", "nycif"],
  "textdomain": "nycif-events-map",
  "supports": {
    "html": false
  },
  "attributes": {
    "height": {
      "type": "string",
      "default": "85vh"
    },
    "cache": {
      "type": "string",
      "default": "public-map-v10"
    },
    "feeds": {
      "type": "string",
      "default": "main"
    },
    "reset_filters": {
      "type": "string",
      "default": "1"
    },
    "clusters": {
      "type": "string",
      "default": "0"
    },
    "loading": {
      "type": "string",
      "default": "lazy"
    }
  }
}
