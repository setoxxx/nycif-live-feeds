{
  "contract": "nycif.borg-address-occupancy-discovery.v1",
  "status": "DRAFT_PROTECTED",
  "purpose": "Guide BORG discovery so multiple businesses, permits, facilities and subpremises at one NYC address are preserved and reconciled instead of collapsed or rejected as duplicates.",
  "upstream_authority": "nycif.address-occupancy-resolution.v1 in nycif-data-pipeline",
  "principle": "ADDRESS_IS_CLUSTER_NOT_IDENTITY",
  "discovery_order": [
    "NORMALIZE_ADDRESS",
    "RESOLVE_BBL_BIN_ADDRESS_POINT",
    "COLLECT_SUBPREMISE_TOKENS",
    "COLLECT_ALL_AUTHORIZED_SOURCE_RECORDS_AT_ADDRESS",
    "GROUP_BY_AUTHORITATIVE_ENTITY_OR_LICENSE_IDENTIFIER",
    "DETECT_ALIAS_SUCCESSOR_PREDECESSOR_OR_UNRELATED_COLOCATION",
    "PRESERVE_UNRESOLVED_RECORDS",
    "EMIT_EXPLICIT_TERMINAL_RECONCILIATION_STATE"
  ],
  "source_priority": [
    {
      "source_family": "NYC_DCP_GEOSUPPORT_PAD",
      "role": "address normalization / address point / BBL / BIN / geography"
    },
    {
      "source_family": "NYC_DCP_MAPPLUTO",
      "role": "property/tax-lot/building context only"
    },
    {
      "source_family": "NYC_DCWP_ISSUED_LICENSES",
      "role": "regulated business/license/entity evidence"
    },
    {
      "source_family": "NYC_DOHMH_RESTAURANT_INSPECTIONS",
      "role": "restaurant-permit identity and food-service evidence"
    },
    {
      "source_family": "NYC_DOHMH_OTHER_PERMITS",
      "role": "other health-regulated public business/place evidence"
    },
    {
      "source_family": "OTHER_APPROVED_AUTHORITATIVE_SOURCE",
      "role": "only after provenance/rights review"
    }
  ],
  "same_address_rules": {
    "reject_second_business_because_address_already_seen": false,
    "dedupe_by_address_only": false,
    "dedupe_by_bbl_only": false,
    "dedupe_by_bin_only": false,
    "dedupe_by_owner_name": false,
    "preserve_multiple_license_numbers": true,
    "preserve_multiple_authoritative_entity_ids": true,
    "preserve_mixed_residential_commercial_context": true,
    "preserve_historical_business_turnover": true
  },
  "entity_resolution": {
    "strong_keys": [
      "authoritative business/entity identifier",
      "license/permit identifier",
      "CAMIS or equivalent permit identity",
      "explicit government crosswalk",
      "manually certified canonical business/location relationship"
    ],
    "weak_keys_never_sufficient_alone": [
      "same address",
      "same unit",
      "same BBL",
      "same BIN",
      "same owner surname",
      "similar DBA",
      "same cultural area"
    ]
  },
  "property_owner_rules": {
    "mappluto_owner_name_is_property_context": true,
    "mappluto_owner_name_is_business_owner": false,
    "mappluto_owner_name_is_resident": false,
    "owner_name_may_create_culture_identity": false,
    "public_reader_default_exposes_property_owner_name": false
  },
  "terminal_states": [
    "CANONICAL_MATCH",
    "NEW_ENTITY_CANDIDATE",
    "SAME_ENTITY_ALIAS_CANDIDATE",
    "SUCCESSOR_PREDECESSOR_REVIEW",
    "UNRELATED_COLOCATED",
    "SUBPREMISE_REVIEW_REQUIRED",
    "HISTORICAL_OR_CLOSED",
    "SOURCE_CONFLICT_REVIEW_REQUIRED",
    "OUT_OF_SCOPE"
  ],
  "accounting": {
    "every_input_record_gets_terminal_state": true,
    "silent_loss_allowed": false
  },
  "culture_boundary": {
    "address_or_property_context_can_create_culture_eligibility": false,
    "business_name_can_create_culture_eligibility": false,
    "owner_name_can_create_culture_eligibility": false,
    "culture_evidence_review_remains_separate": true
  },
  "privacy": {
    "build_private_household_or_resident_profiles": false,
    "track_people_at_residential_units": false,
    "use_public_subpremise_only_when_needed_for_public_business_location": true,
    "track_help_seeker_or_immigration_status": false
  }
}
